# ISE API Configuration
# Note: These environment variables are used by both ERS API and MNT API clients
ISE_IP= # The IP address or hostname of your ISE server (used for API base URL)

# --- Authentication (choose ONE approach) ---------------------------------
# 1) Service-account Basic auth (used when no per-user header is sent):
API_USERNAME= # Admin username for API authentication
API_PWD=      # Admin password for API authentication

# 2) Client-certificate auth (standalone: when set, NO Authorization header
#    is sent and ISE authenticates the API user from the cert). Cert and key
#    must be provided together. Supply the passphrase only if the key is
#    encrypted. NOTE: applies to the ISE Open APIs only -- the MnT API does
#    NOT support certificate auth, so the session/AAA-failure tools still need
#    API_USERNAME/API_PWD (or a forwarded per-user header) even in cert mode.
ISE_CLIENT_CERT=          # Path to client certificate PEM
ISE_CLIENT_KEY=           # Path to client private-key PEM
ISE_CLIENT_KEY_PASSWORD=  # Passphrase for an encrypted key (leave blank if none)

# --- Server certificate verification --------------------------------------
# Verification is ON by default. If you connect by IP to a self-signed /
# internal-CA ISE, either point ISE_CA_BUNDLE at the trusted cert, disable
# hostname matching, or (testing only) disable verification entirely.
ISE_VERIFY_SERVER_CERT=true  # false disables verification (testing only)
ISE_VERIFY_HOSTNAME=true     # false verifies the chain but skips hostname/SAN
                             # matching (must be false if VERIFY_SERVER_CERT=false)
ISE_CA_BUNDLE=               # Path to a CA/self-signed cert to trust

# --- Session-tool resource usage & backpressure ----------------------------
ISE_MNT_GATE_MAX_CONCURRENCY=1    # Max concurrent heavy MnT reads (AuthList, summary)
ISE_MNT_GATE_MIN_INTERVAL_S=0.0   # Min seconds between heavy MnT read starts (0 = off)
ISE_MNT_GATE_BACKOFF_BASE_S=5.0   # Circuit-breaker base backoff after MnT distress
ISE_MNT_GATE_BACKOFF_MAX_S=300.0  # Circuit-breaker max backoff

# --- Node-log downloads (certificate/deployment diagnostics) ----------------
ISE_LOG_DOWNLOAD_MAX_CONCURRENCY=1  # Max concurrent node-log (.log.zip) downloads (1-4)

# Server Settings
HOST=0.0.0.0
PORT=5000
